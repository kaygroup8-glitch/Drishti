{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/mcp-config.json",
      "destination": "/api/mcp-config"
    },
    {
      "source": "/api/webmcp-manifest.json",
      "destination": "/api/webmcp-manifest"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
